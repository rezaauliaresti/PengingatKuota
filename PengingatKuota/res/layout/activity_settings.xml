<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nama kamu"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etBatas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Batas peringatan (GB)"
            android:inputType="numberDecimal" />

        <Switch
            android:id="@+id/swDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mode gelap" />

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simpan Pengaturan" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#44888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Paket Kuota Baru"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Total kuota (GB), contoh 10"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etHari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masa aktif (hari), contoh 30"
            android:inputType="number" />

        <Button
            android:id="@+id/btnAktifkan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aktifkan Paket (isi ulang)" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Reset Semua Data" />
    </LinearLayout>
</ScrollView>
